{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Sources": {
    "Csv": {
      "Enabled": true,
      "Folder": "data/input",
      "Delimiter": ",",
      "Files": [
        {
          "Name": "clients",
          "FileName": "clients.csv"
        },
        {
          "Name": "products",
          "FileName": "products.csv"
        },
        {
          "Name": "fuente_datos",
          "FileName": "fuente_datos.csv"
        },
        {
          "Name": "surveys",
          "FileName": "surveys_part1.csv"
        }
      ]
    },
    "Database": {
      "Enabled": true,
      "ConnectionString": "",
      "Query": "SELECT o.IdOpinion, o.IdOrigen, o.Canal, o.Fecha, o.Comentario, o.Puntaje, o.IdCliente, o.IdProducto, o.IdClasificacion, o.IdFuente FROM dbo.Opinion o INNER JOIN dbo.Fuente_Datos f ON f.IdFuente = o.IdFuente WHERE f.TipoFuente = N'Web'",
      "CommandTimeoutSeconds": 60
    },
    "Api": {
      "Enabled": true,
      "BaseUrl": "http://localhost:5100",
      "Endpoint": "/api/social-comments",
      "ApiKey": "",
      "TimeoutSeconds": 30,
      "PageSize": 100,
      "MaxParallelRequests": 4
    }
  },
  "Staging": {
    "OutputFolder": "data/staging"
  }
}